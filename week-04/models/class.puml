@startuml class
title Smart Campus - Study Room Booking\nDomain class diagram (revised)

skinparam classAttributeIconSize 0
skinparam shadowing false

class Student {
  - studentId : String
  ' US-03: the student picks which own booking to cancel
  + activeBookings() : Booking[*]
}

class Room {
  - roomId : String
  - name : String
  - blocked : Boolean = false
  + isBlocked() : Boolean
  + isFreeAt(start : DateTime, duration : Duration) : Boolean
  + block()
  + unblock()
  + bookingsBetween(from : DateTime, to : DateTime) : Booking[*]
}

class Booking {
  - bookingId : String
  - start : DateTime
  - duration : Duration
  - status : BookingStatus = ACTIVE
  + end() : DateTime
  + isActive() : Boolean
  + overlaps(start : DateTime, duration : Duration) : Boolean
  + isOwnedBy(student : Student) : Boolean
  + cancel(requester : Student)
}

class Confirmation {
  - code : String
  - issuedAt : DateTime
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

Student "1" -right- "0..*" Booking : makes >
Booking "0..*" -right- "1" Room : is for >
Booking "1" -down- "1" Confirmation : produces >

note top of Booking
  R1 (checked before a Booking is created):
  start > now and 0 < duration <= 2 h
  R2: no two ACTIVE bookings of the same Room overlap.
  Intervals are [start, start + duration):
  a booking ending 10:00 and one starting 10:00
  do not overlap (A2).
end note

note right of Room
  R3: no new Booking while blocked = true.
  Blocking keeps existing bookings (A1).
  isFreeAt = not blocked AND no ACTIVE booking
  overlaps [start, start + duration) (A3)
end note

note right of Confirmation
  R4: exactly one per successful booking
end note
@enduml
